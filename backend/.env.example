# Copy to .env and fill in. Every value has a working default.
#
# The AI layer has TWO independent providers. They fail separately on
# purpose: losing the reranker does not lose semantic search, and losing
# embeddings does not lose search at all.
#
#   EMBEDDING_PROVIDER  -> recall  (which dishes are candidates)
#   LLM_PROVIDER        -> reasoning (constraint extraction + reranking)

# Where the local ONNX model is cached. Empty = <backend>/.model_cache.
# Pinned inside the project on purpose: the library's default is %TEMP%,
# which Windows Disk Cleanup is free to delete.
EMBEDDING_CACHE_DIR=

# --- Recall: embeddings ----------------------------------------------------
# auto   - hosted if a key is set, else the local model
# local  - offline ONNX model, no key, no network, no per-call cost
# gemini - hosted
# none   - skip embeddings entirely; search runs on BM25
EMBEDDING_PROVIDER=local

# --- Reasoning: LLM --------------------------------------------------------
# auto   - Groq if a key is set, else Gemini, else rules-only
# groq | gemini | none
LLM_PROVIDER=auto

# Groq — free tier, OpenAI-compatible, very low latency.
# Key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini — alternative LLM provider, and the only hosted embedding option.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.0-flash

AI_TIMEOUT_SECONDS=8
AI_CANDIDATE_POOL=12
AI_ENABLED=true

# --- Auth ------------------------------------------------------------------
# CHANGE THIS in any real deployment.
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Persistence -----------------------------------------------------------
DATABASE_URL=sqlite:///./savora.db

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
